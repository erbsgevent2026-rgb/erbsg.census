# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing authentication tokens and session security.
JWT_SECRET="erbsg_production_jwt_secret_key_railway_scouts_guides"

# EMAIL_API_KEY: Optional API key for Resend / SendGrid / SMTP outbound emails.
EMAIL_API_KEY=""

# EMAIL_FROM: Official sender email for ERBSG Data Control Portal notifications.
EMAIL_FROM="erbsg-portal@easternrailway.gov.in"

# DATABASE_PATH: Path to persistent production SQLite database file outside deployment directory.
# Recommended persistent location on Hostinger:
# /home/u681527468/domains/erbsg.org/nodejs/data/erbsg.sqlite
# If not specified, automatically defaults to the persistent Hostinger nodejs/data path.
DATABASE_PATH="/home/u681527468/domains/erbsg.org/nodejs/data/erbsg.sqlite"

# ALLOW_DATABASE_CREATION: Safety flag. Set to "true" (or set INIT_FRESH_DATABASE="true")
# temporarily to create and seed the fresh database. Once initialized, set back to "false"
# for standard production operation to permanently prevent accidental recreation or wipes.
ALLOW_DATABASE_CREATION="false"

# DATABASE_BACKUP_DIR: Optional dedicated directory for rolling pre-startup database backup copies.
# If not specified, defaults to the 'backups' subdirectory next to DATABASE_PATH.
# Example: /home/u681527468/domains/erbsg.org/nodejs/data/backups
DATABASE_BACKUP_DIR="/home/u681527468/domains/erbsg.org/nodejs/data/backups"

# INITIAL_ADMIN_PASSWORD: Optional initial password for State Administrator (BSG-ER-STATE) during fresh database setup.
# If not specified, defaults to Admin@ERBSG2026. Only used on initial account seeding; never resets existing accounts.
INITIAL_ADMIN_PASSWORD="Admin@ERBSG2026"

# INITIAL_DISTRICT_PASSWORD: Optional initial password for the 9 District User accounts during fresh database setup.
# If not specified, defaults to Test@1234. On first login, district users are required to set their own password.
INITIAL_DISTRICT_PASSWORD="Test@1234"



