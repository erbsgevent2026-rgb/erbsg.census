# ==============================================================================
# ERBSG DATA CONTROL PORTAL — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Hostinger Node.js Application Hosting
# Domain: https://erbsg.org
#
# IMPORTANT DEPLOYMENT RULES:
# 1. Do NOT commit real production passwords, secrets, or API keys to git.
# 2. Configure these variables in Hostinger hPanel -> Advanced -> Node.js -> Environment Variables.
# 3. Server Restart vs Redeployment:
#    - Changes to DATABASE_PATH, DATABASE_BACKUP_DIR, ALLOW_DATABASE_CREATION,
#      JWT_SECRET, PORT, INITIAL_ADMIN_PASSWORD take effect immediately upon SERVER RESTART.
#    - Client-facing build changes (frontend code, VITE_* variables) require REBUILD (npm run build).
# ==============================================================================

# NODE_ENV: Application environment mode. Set to 'production' on Hostinger.
NODE_ENV="production"

# PORT: The port the Node.js HTTP server binds to.
# Hostinger assigns an internal port or defaults to 3000.
PORT=3000

# DATABASE_PATH: Authoritative persistent path to the SQLite production database.
# CRITICAL: Must be located OUTSIDE volatile deployment folders (/current, /hbuilds, dist).
# Hostinger persistent path recommendation:
DATABASE_PATH="/home/u681527468/domains/erbsg.org/nodejs/data/erbsg.sqlite"

# DATABASE_BACKUP_DIR: Directory for automated rolling pre-startup and manual backup snapshots.
# Must be outside volatile deployment folders. Defaults to <dirname(DATABASE_PATH)>/backups.
DATABASE_BACKUP_DIR="/home/u681527468/domains/erbsg.org/nodejs/data/backups"

# ALLOW_DATABASE_CREATION: Controlled first-time database bootstrap flag.
# - Set to "true" ONLY during initial first-time production deployment to initialize schema
#   and seed the State Admin (BSG-ER-STATE) and 9 District accounts.
# - IMMEDIATELY set back to "false" after successful initialization to protect existing records.
ALLOW_DATABASE_CREATION="false"

# JWT_SECRET: Strong secret key used for signing session tokens and password reset tokens.
# REQUIRED FOR PRODUCTION: Operator MUST generate and supply a strong random 64-character string.
# Example generator: openssl rand -base64 48
JWT_SECRET="PLEASE_GENERATE_A_SECURE_64_CHARACTER_RANDOM_SECRET_KEY_FOR_PRODUCTION"

# INITIAL_ADMIN_PASSWORD: One-time setup password for State Administrator (BSG-ER-STATE).
# Only applied when creating a brand-new database; never resets or overwrites changed passwords.
INITIAL_ADMIN_PASSWORD="Admin@ERBSG2026"

# INITIAL_DISTRICT_PASSWORD: One-time setup password for the 9 District user accounts.
# Default: Test@1234. Enforces 'must_change_password=1' so users change credentials on first login.
INITIAL_DISTRICT_PASSWORD="Test@1234"

# EMAIL_API_KEY: Optional API key for outbound transactional email dispatch (Resend/SendGrid/SMTP).
EMAIL_API_KEY=""

# EMAIL_FROM: Sender identity for automated official portal notifications.
EMAIL_FROM="erbsg-portal@easternrailway.gov.in"

# GEMINI_API_KEY: Optional server-side Gemini AI API key for intelligence & data analysis features.
GEMINI_API_KEY=""

# APP_URL: Canonical public URL of the portal.
APP_URL="https://erbsg.org"
